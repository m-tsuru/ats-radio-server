[Unit]
Description=ATS network radio daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/radiod -config /etc/radiod/config.json
User=radiod
Group=radiod
RuntimeDirectory=radiod
StateDirectory=radiod
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/radiod /run/radiod

[Install]
WantedBy=multi-user.target
